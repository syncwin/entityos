{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncwin/entityos/schema/sop.schema.json",
  "title": "EntityOS SOP",
  "description": "One standard operating procedure for an entity, as a Markdown document.",
  "type": "object",
  "required": [
    "id",
    "entity_id",
    "title",
    "status",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique across the vault."
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "description": "Entity id; must exist in config/owner.yaml."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "deprecated",
        "conflicting",
        "draft"
      ],
      "description": "Same values as claims. Agents never set verified."
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of the last change (YYYY-MM-DD)."
    }
  }
}
