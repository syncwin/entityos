{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncwin/entityos/schema/claim.schema.json",
  "title": "EntityOS claim",
  "description": "One atomic, individually sourced fact. PRD section 6.",
  "type": "object",
  "required": ["id", "statement", "status", "source_id", "verified_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Unique per entity." },
    "statement": { "type": "string", "minLength": 1, "description": "One atomic fact." },
    "status": { "type": "string", "enum": ["verified", "unverified", "deprecated", "conflicting", "draft"] },
    "source_id": { "type": "string", "minLength": 1, "description": "Required: no claim without a source." },
    "verified_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date; null if unverified." }
  }
}
