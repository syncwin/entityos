{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncwin/entityos/schema/source.schema.json",
  "title": "EntityOS source",
  "description": "Provenance for claims. PRD section 6.",
  "type": "object",
  "required": ["id", "title", "type"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Unique per entity." },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "description": "Optional if the source is a private doc." },
    "type": { "type": "string", "enum": ["official", "first_party", "government", "documentation", "internal", "third_party", "unknown"] },
    "verified_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date. TODO(PRD): whether required, and whether null is allowed, is not stated." }
  }
}
